#!/usr/bin/env python3
from __future__ import annotations

import os
import sys
from pathlib import Path


def main() -> int:
    root = Path(__file__).resolve().parents[2]
    source = (root / "product" / "scripts" / "gve").resolve()
    if not source.is_file():
        print(f"gve install: maintained launcher not found: {source}", file=sys.stderr)
        return 1

    home = os.environ.get("HOME")
    if not home:
        print("gve install: HOME is not set", file=sys.stderr)
        return 1

    bin_dir = Path(home).expanduser().resolve() / ".local" / "bin"
    target = bin_dir / "gve"

    try:
        bin_dir.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        print(f"gve install: cannot create {bin_dir}: {exc}", file=sys.stderr)
        return 1

    if target.is_symlink():
        try:
            existing = target.resolve(strict=False)
        except OSError as exc:
            print(f"gve install: cannot inspect existing launcher {target}: {exc}", file=sys.stderr)
            return 1
        if existing == source:
            print(f"gve install: already installed {target} -> {source}")
            return 0
        print(
            f"gve install: conflicting launcher exists: {target} -> {existing}",
            file=sys.stderr,
        )
        return 1

    if target.exists():
        print(f"gve install: conflicting launcher exists: {target}", file=sys.stderr)
        return 1

    try:
        target.symlink_to(source)
    except OSError as exc:
        print(f"gve install: cannot create launcher {target}: {exc}", file=sys.stderr)
        return 1

    print(f"gve install: installed {target} -> {source}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
