{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GVE-SPECIFICATION-SET.schema.json",
  "title": "GVE Normative Specification-Set Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "canonicalization",
    "digest_algorithm",
    "identity_format",
    "members"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/GVE-SPECIFICATION-SET.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "canonicalization": {
      "const": "gve-canonical-json-v1"
    },
    "digest_algorithm": {
      "const": "sha256"
    },
    "identity_format": {
      "type": "string",
      "enum": [
        "gve-canonical-json-v1+sha256:lowercase-hex",
        "gve-spec-revision-sha256:<digest>"
      ]
    },
    "identity_framework": {
      "$ref": "#/$defs/identityFramework"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/member"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identityFramework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "path",
        "schema_path",
        "projection_path",
        "vectors_path",
        "content_sha256",
        "schema_sha256",
        "projection_sha256",
        "vectors_sha256"
      ],
      "properties": {
        "id": {
          "const": "GVE-IDENTITY-FRAMEWORK"
        },
        "version": {
          "const": "1.0.0"
        },
        "path": {
          "const": "identity/GVE-IDENTITY-FRAMEWORK.json"
        },
        "schema_path": {
          "const": "schemas/GVE-IDENTITY-FRAMEWORK.schema.json"
        },
        "projection_path": {
          "const": "identity/GVE-IDENTITY-FRAMEWORK.md"
        },
        "vectors_path": {
          "const": "tests/fixtures/issue_76/identity_vectors.json"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "vectors_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "id",
        "content_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^levels/level-[0-9]+/GVE-LEVEL-[0-9]+(?:-[A-Z0-9]+(?:-[A-Z0-9]+)*)?\\.json$"
        },
        "role": {
          "type": "string",
          "enum": [
            "root",
            "subordinate"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^GVE-LEVEL-[0-9]+(?:-[A-Z0-9]+(?:-[A-Z0-9]+)*)?$"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
