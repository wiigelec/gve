{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GVE-SPECIFICATION-SET.schema.json",
  "title": "GVE Normative Specification-Set Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "canonicalization",
    "digest_algorithm",
    "identity_format",
    "members"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/GVE-SPECIFICATION-SET.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "canonicalization": {
      "const": "gve-canonical-json-v1"
    },
    "digest_algorithm": {
      "const": "sha256"
    },
    "identity_format": {
      "const": "gve-canonical-json-v1+sha256:lowercase-hex"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/member"
      }
    }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "id",
        "content_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^levels/level-[0-9]+/GVE-LEVEL-[0-9]+(?:-[A-Z0-9]+(?:-[A-Z0-9]+)*)?\\.json$"
        },
        "role": {
          "type": "string",
          "enum": [
            "root",
            "subordinate"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^GVE-LEVEL-[0-9]+(?:-[A-Z0-9]+(?:-[A-Z0-9]+)*)?$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
