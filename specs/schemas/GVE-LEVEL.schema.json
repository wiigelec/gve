{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GVE-LEVEL.schema.json",
  "title": "GVE Level Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "specification",
    "summary",
    "definitions",
    "requirements",
    "relationships",
    "scope"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "level",
        "title",
        "version",
        "status",
        "parent"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^GVE-LEVEL-[0-9]+(?:-[A-Z0-9]+(?:-[A-Z0-9]+)*)?$"
        },
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "normative",
            "retired"
          ]
        },
        "parent": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^GVE-LEVEL-[0-9]+(?:-[A-Z0-9]+(?:-[A-Z0-9]+)*)?$"
            }
          ]
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "root",
        "imports"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "root",
            "subordinate"
          ]
        },
        "root": {
          "type": "string",
          "pattern": "^GVE-LEVEL-[0-9]+(?:-[A-Z0-9]+(?:-[A-Z0-9]+)*)?$"
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^GVE-LEVEL-[0-9]+(?:-[A-Z0-9]+(?:-[A-Z0-9]+)*)?$"
          },
          "uniqueItems": true
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^GVE-LEVEL-[0-9]+(?:-[A-Z0-9]+(?:-[A-Z0-9]+)*)?$"
          },
          "uniqueItems": true
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "effect_state_model": {
      "$ref": "#/$defs/effectStateModel"
    },
    "definitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/definition"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includes",
        "excludes"
      ],
      "properties": {
        "includes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "term",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "references"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "relation",
        "target"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "relation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "target": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "effectStateValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_requirement",
        "uncertainty_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "evidence_requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "uncertainty_required": {
          "type": "boolean"
        }
      }
    },
    "effectStateReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "value"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        }
      }
    },
    "effectStateModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "effect_identity_required",
        "dimensions",
        "implications",
        "non_implications",
        "prohibited_combinations",
        "assertion_record",
        "lineage",
        "authoritative_result",
        "result_constraints"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "effect_identity_required": {
          "type": "boolean",
          "const": true
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "assertion_authority",
              "values"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "assertion_authority": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/effectStateValue"
                }
              }
            }
          }
        },
        "implications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target",
              "same_effect",
              "same_evidence_context"
            ],
            "properties": {
              "source": {
                "$ref": "#/$defs/effectStateReference"
              },
              "target": {
                "$ref": "#/$defs/effectStateReference"
              },
              "same_effect": {
                "type": "boolean"
              },
              "same_evidence_context": {
                "type": "boolean"
              }
            }
          }
        },
        "non_implications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "$ref": "#/$defs/effectStateReference"
              },
              "target": {
                "$ref": "#/$defs/effectStateReference"
              }
            }
          }
        },
        "prohibited_combinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "states",
              "reason"
            ],
            "properties": {
              "states": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/effectStateReference"
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          }
        },
        "assertion_record": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_fields",
            "one_current_head_per_effect_dimension",
            "immutable_history",
            "verification_claim_identity_required",
            "verification_evidence_identity_required"
          ],
          "properties": {
            "required_fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
              },
              "uniqueItems": true
            },
            "one_current_head_per_effect_dimension": {
              "type": "boolean"
            },
            "immutable_history": {
              "type": "boolean"
            },
            "verification_claim_identity_required": {
              "type": "boolean"
            },
            "verification_evidence_identity_required": {
              "type": "boolean"
            }
          }
        },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statuses",
            "correction_disposition",
            "supersession_same_effect_required",
            "supersession_same_dimension_required",
            "correction_reason_required",
            "new_evidence_basis_required"
          ],
          "properties": {
            "statuses": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "uniqueItems": true
            },
            "correction_disposition": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "supersession_same_effect_required": {
              "type": "boolean"
            },
            "supersession_same_dimension_required": {
              "type": "boolean"
            },
            "correction_reason_required": {
              "type": "boolean"
            },
            "new_evidence_basis_required": {
              "type": "boolean"
            }
          }
        },
        "authoritative_result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assertion_authority",
            "required_fields",
            "exact_current_state_coverage_required",
            "exact_current_assertion_binding_required",
            "exact_admitted_evidence_binding_required"
          ],
          "properties": {
            "assertion_authority": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "required_fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
              },
              "uniqueItems": true
            },
            "exact_current_state_coverage_required": {
              "type": "boolean"
            },
            "exact_current_assertion_binding_required": {
              "type": "boolean"
            },
            "exact_admitted_evidence_binding_required": {
              "type": "boolean"
            }
          }
        },
        "result_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "admitted_evidence_bound",
            "preserve_adverse_facts",
            "conflict_or_incompleteness_fails_closed"
          ],
          "properties": {
            "admitted_evidence_bound": {
              "type": "boolean"
            },
            "preserve_adverse_facts": {
              "type": "boolean"
            },
            "conflict_or_incompleteness_fails_closed": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
