{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GVE-STAGE-2-COMMON-PAYLOAD.schema.json",
  "title": "GVE Stage 2 Common Payload — No-op Lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lifecycle",
    "workflow"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "lifecycle": {
      "type": "string",
      "const": "no-op"
    },
    "workflow": {
      "$ref": "#/$defs/workflow"
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_id",
        "action"
      ],
      "properties": {
        "plugin_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "action": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "plugin",
        "content"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "plugin": {
          "$ref": "#/$defs/plugin"
        },
        "content": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "operations"
      ],
      "properties": {
        "workflow_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    }
  }
}
