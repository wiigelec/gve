{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GVE-IDENTITY-FRAMEWORK.schema.json",
  "title": "GVE Unified Identity Framework Core",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "authority",
    "representation",
    "canonicalization_versions",
    "digest_algorithms",
    "canonical_preimage",
    "embedded_identity_rules",
    "reference_semantics",
    "object_kinds",
    "aggregate_semantics",
    "fail_closed_conditions",
    "framework_invariants",
    "identity_families",
    "fixed_vectors",
    "repository_integration"
  ],
  "properties": {
    "identity_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/identityFamily"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "identityFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "semantic_domain",
        "domain_separation_prefix",
        "canonicalization_version",
        "digest_algorithm",
        "preimage",
        "object_kind",
        "aggregate"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "semantic_domain": {
          "type": "string"
        },
        "domain_separation_prefix": {
          "type": "string"
        },
        "canonicalization_version": {
          "type": "string"
        },
        "digest_algorithm": {
          "type": "string"
        },
        "preimage": {
          "$ref": "#/$defs/preimage"
        },
        "object_kind": {
          "enum": [
            "object",
            "ordered-aggregate",
            "unordered-aggregate",
            "transitive-closure"
          ]
        },
        "aggregate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/aggregateDefinition"
            }
          ]
        }
      }
    },
    "preimage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_source",
        "own_identity_paths",
        "reference_paths",
        "reference_encoding",
        "allowed_reference_family_ids",
        "aggregate_encoding",
        "version_bindings"
      ],
      "properties": {
        "value_source": {
          "const": "complete-object"
        },
        "own_identity_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "reference_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "reference_encoding": {
          "enum": [
            "by-value",
            "by-identity",
            "identity-plus-value"
          ]
        },
        "allowed_reference_family_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "aggregate_encoding": {
          "enum": [
            "member-references",
            null
          ]
        },
        "version_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonicalization",
            "governing_specification_revision"
          ],
          "properties": {
            "canonicalization": {
              "type": "boolean"
            },
            "governing_specification_revision": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "aggregateDefinition": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "member_family_ids",
        "membership",
        "ordering_significance",
        "duplicate_policy",
        "closure_boundary",
        "member_reference_mode",
        "empty_aggregate_rule",
        "cycle_policy",
        "membership_path",
        "member_identity_path",
        "member_value_path"
      ],
      "properties": {
        "member_family_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "ordering_significance": {
          "enum": [
            "ordered",
            "unordered"
          ]
        },
        "closure_boundary": {
          "enum": [
            "direct",
            "transitive"
          ]
        },
        "member_reference_mode": {
          "enum": [
            "by-value",
            "by-identity",
            "identity-plus-value"
          ]
        },
        "membership_path": {
          "type": "string",
          "minLength": 1
        },
        "member_identity_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "member_value_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "duplicate_policy": {
          "enum": [
            "reject",
            "permit"
          ]
        },
        "empty_aggregate_rule": {
          "enum": [
            "reject",
            "permit"
          ]
        },
        "cycle_policy": {
          "const": "reject"
        }
      }
    }
  }
}
