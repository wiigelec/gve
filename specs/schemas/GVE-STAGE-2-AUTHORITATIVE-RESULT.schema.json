{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GVE-STAGE-2-AUTHORITATIVE-RESULT.schema.json",
  "title": "GVE Stage 2 Authoritative Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "request_id",
    "lifecycle",
    "processing",
    "workflow",
    "diagnostics",
    "process"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "const": "no-op"
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "failure_stage"
      ],
      "properties": {
        "status": {
          "enum": [
            "succeeded",
            "rejected",
            "failed"
          ]
        },
        "failure_stage": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "payload-validation",
                "identity-validation",
                "no-op-disposition",
                "result-construction"
              ]
            }
          ]
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "status",
        "effects",
        "operations"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "no-op-completed",
            "rejected",
            "failed"
          ]
        },
        "effects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "authorization",
            "execution",
            "observation",
            "verification"
          ],
          "properties": {
            "request": {
              "enum": [
                "requested",
                "not-requested"
              ]
            },
            "authorization": {
              "enum": [
                "authorized",
                "refused",
                "indeterminate"
              ]
            },
            "execution": {
              "enum": [
                "unattempted",
                "attempted",
                "partial",
                "completed",
                "failed",
                "cancelled",
                "timed-out",
                "indeterminate"
              ]
            },
            "observation": {
              "enum": [
                "unobserved",
                "observed",
                "contradicted",
                "indeterminate"
              ]
            },
            "verification": {
              "enum": [
                "unverified",
                "verified",
                "failed",
                "contradicted",
                "indeterminate"
              ]
            }
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation_id",
              "status",
              "effects"
            ],
            "properties": {
              "operation_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "no-op",
                  "unattempted",
                  "failed"
                ]
              },
              "effects": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "request",
                  "authorization",
                  "execution",
                  "observation",
                  "verification"
                ],
                "properties": {
                  "request": {
                    "enum": [
                      "requested",
                      "not-requested"
                    ]
                  },
                  "authorization": {
                    "enum": [
                      "authorized",
                      "refused",
                      "indeterminate"
                    ]
                  },
                  "execution": {
                    "enum": [
                      "unattempted",
                      "attempted",
                      "partial",
                      "completed",
                      "failed",
                      "cancelled",
                      "timed-out",
                      "indeterminate"
                    ]
                  },
                  "observation": {
                    "enum": [
                      "unobserved",
                      "observed",
                      "contradicted",
                      "indeterminate"
                    ]
                  },
                  "verification": {
                    "enum": [
                      "unverified",
                      "verified",
                      "failed",
                      "contradicted",
                      "indeterminate"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "diagnostic_id",
          "code",
          "stage",
          "scope",
          "message"
        ],
        "properties": {
          "diagnostic_id": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "enum": [
              "GVE-S2-INVALID-JSON",
              "GVE-S2-INVALID-PAYLOAD",
              "GVE-S2-DUPLICATE-IDENTITY",
              "GVE-S2-PROCESSING-FAILURE",
              "GVE-S2-RESULT-CONSTRUCTION-FAILURE"
            ]
          },
          "stage": {
            "enum": [
              "utf8-decoding",
              "json-parsing",
              "payload-validation",
              "identity-validation",
              "no-op-disposition",
              "result-construction"
            ]
          },
          "scope": {
            "enum": [
              "request",
              "workflow",
              "operation",
              "result"
            ]
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "workflow_id": {
            "type": "string",
            "minLength": 1
          },
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "stdout",
        "stderr"
      ],
      "properties": {
        "exit_code": {
          "enum": [
            0,
            2,
            3
          ]
        },
        "stdout": {
          "const": "authoritative-result"
        },
        "stderr": {
          "const": "empty"
        }
      }
    }
  }
}
