#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    printf '%s\n' "validate: no supported Python interpreter found" >&2
    exit 2
fi

"$PYTHON" -m unittest discover -s specs/tests
PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
    "$PYTHON" -m unittest discover -s src/scf_governed_executor/tests
"$PYTHON" -m specs.tooling.validate --specs-root specs
git diff --check
