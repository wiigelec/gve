#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    printf '%s\n' "validate: no supported Python interpreter found" >&2
    exit 2
fi

#"$PYTHON" -m unittest discover -s specs/tests
#"$PYTHON" -m unittest discover -s tests/cli
#"$PYTHON" -m unittest discover -s tests/core
#"$PYTHON" -m specs.tooling.validate --specs-root specs
#"$PYTHON" -m specs.tooling.validate_identity
specification-system/repo/validate
git diff --check
