#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    printf '%s\n' "repository-specification validate: no supported Python interpreter found" >&2
    exit 2
fi

exec "$PYTHON" "$ROOT/validation/intrinsic/validate_skeleton.py" --root "$ROOT"
