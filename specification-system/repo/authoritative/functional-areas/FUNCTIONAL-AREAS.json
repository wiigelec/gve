{
  "construction_identity": "functional-areas",
  "construction_status": "under-construction",
  "responsibility": "Extend the minimal repository vocabulary into a generic functional layout model with closed functional areas, per-area semantics, and product-neutral extension rules without defining final identities, transport, or hosting-platform semantics.",
  "normative": false,
  "repository_vocabulary_identity": "repository-model",
  "functional_areas": [
    "overview-documentation",
    "implementation-planning",
    "repository-specifications",
    "product-specifications",
    "maintained-product-source",
    "tests",
    "schemas",
    "conformance",
    "generated-artifacts",
    "validation",
    "repository-tooling",
    "packaging-and-release",
    "temporary-development-state"
  ],
  "area_semantics": {
    "overview-documentation": {
      "description": "Product-direction documents (product-overview) that define intended users, outcomes, capabilities, and constraints.",
      "kind": "authority",
      "authority_classification": "non-normative",
      "lifecycle_classification": "maintained",
      "ownership_role": "area-owner",
      "containment": "may-contain-other-functional-areas",
      "dependency": "none",
      "path_significance": "well-known-root",
      "ignored_content": false,
      "required": true,
      "product_profile_extensible": false
    },
    "implementation-planning": {
